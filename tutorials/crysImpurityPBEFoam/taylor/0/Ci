FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Ci;
}

dimensions      [1 -3 0 0 0 0 0];
internalField   uniform 2;

boundaryField
{
    innerWall { type zeroGradient; }
    outerWall { type zeroGradient; }
    bottom    { type zeroGradient; }
    top       { type zeroGradient; }
    front     { type wedge; }
    back      { type wedge; }
}
